---
import Base from "../layouts/Base.astro";
import CustomSelect from "../components/CustomSelect.astro";
import { CITY_DIRECTORY } from "../lib/geo";
import { CHRONOTYPE_LABELS, CHRONOTYPE_QUESTIONS, type Chronotype } from "../lib/light";
import { computeSolarDay, formatTime } from "../lib/sun";

const cities = CITY_DIRECTORY;
const chronotypes: Chronotype[] = ["lark", "dove", "owl"];

const today = new Date();
const defaultCity = cities[0];
const defaultSolar = computeSolarDay(today, defaultCity.lat, defaultCity.lon, defaultCity.timezone);

const cityOptions = cities.map((c) => ({
  value: `${c.lat},${c.lon},${c.timezone}`,
  label: `${c.city}, ${c.region}`,
  sub: c.country,
  group: c.country,
}));

const chronotypeOptions = chronotypes.map((ct) => ({
  value: ct,
  label: CHRONOTYPE_LABELS[ct],
}));

const defaultCityValue = `${defaultCity.lat},${defaultCity.lon},${defaultCity.timezone}`;

// Did You Know facts
const facts = [
  "Morning light advances your circadian clock — exposure within 1h of waking shifts it earlier by up to 30 min/day.",
  "ipRGCs (intrinsically photosensitive retinal ganglion cells) are 10,000× less sensitive to red light than blue.",
  "Two hours of outdoor light daily is linked to a 40% reduction in sleep onset latency.",
  "Melatonin suppression begins at just 30 lux of 480nm light — about the brightness of a smartphone at night.",
  "Your circadian rhythm naturally runs ~24.2 hours. Morning light corrects this drift every day.",
  "The suprachiasmatic nucleus contains only ~20,000 neurons but orchestrates clocks in nearly every organ.",
  "Shift workers have a 25-40% higher risk of metabolic disorders due to circadian misalignment.",
  "Golden hour light (~2,700K color temperature) has low melanopic content — ideal for evening exposure.",
  "Blue hour after sunset provides enough melanopic stimulus to delay sleep onset by 40+ minutes.",
  "Children have larger pupils and more transparent lenses — they receive 2-3× more circadian-effective light than adults.",
  "The CIE S 026:2018 standard defines five α-opic illuminances; melanopic-EDI is the key metric for circadian effects.",
  "Spending 30 minutes outdoors in morning light can reduce depression scores by up to 40% in clinical studies.",
] as const;
---

<Base
  title="SunCycle · Circadian Light Planner"
  description="Plan your light exposure around real solar geometry. Free, private, zero APIs."
  canonical="https://suncycle-day3.netlify.app/"
  ogImage="https://suncycle-day3.netlify.app/og-default.svg"
>
  <!-- Hero with CSS gradient sunrise -->
  <section class="hero hero-sunrise">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="fade-in">
            Light is the oldest <em>medicine</em>.
          </h1>
          <p class="lead fade-in fade-in-delay-1">
            SunCycle builds a personal circadian light schedule from your location, the real sun, and peer-reviewed photobiology. No accounts, no tracking, no paid APIs.
          </p>
          <div class="hero-cta fade-in fade-in-delay-2">
            <a href="#planner" class="btn btn-primary">Build my light plan</a>
            <a href="/science" class="btn btn-ghost">Read the science →</a>
          </div>
        </div>
        <div class="hero-visual fade-in fade-in-delay-2">
          <div class="sunrise-scene" role="img" aria-label="Animated sunrise gradient representing circadian light">
            <div class="sunrise-sky">
              <div class="sunrise-sun"></div>
              <div class="sunrise-glow"></div>
              <div class="sunrise-horizon"></div>
            </div>
            <div class="sunrise-waves">
              <div class="wave wave-1"></div>
              <div class="wave wave-2"></div>
              <div class="wave wave-3"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="container">
      <div class="stats-row fade-in">
        <div>
          <div class="stat-value">24h</div>
          <div class="stat-label">Circadian cycle</div>
        </div>
        <div>
          <div class="stat-value">480nm</div>
          <div class="stat-label">ipRGC peak sensitivity</div>
        </div>
        <div>
          <div class="stat-value">30m</div>
          <div class="stat-label">Morning bright light (min)</div>
        </div>
        <div>
          <div class="stat-value">0</div>
          <div class="stat-label">APIs called</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Did You Know carousel -->
  <section class="section" style="padding-block: var(--space-10);">
    <div class="container">
      <div class="facts-carousel fade-in" id="facts-carousel">
        <div class="facts-header">
          <span class="facts-icon" aria-hidden="true">💡</span>
          <span class="facts-label">Did you know?</span>
          <span class="facts-counter" id="facts-counter">1/{facts.length}</span>
        </div>
        <p class="facts-text" id="facts-text">{facts[0]}</p>
        <div class="facts-nav">
          <button class="facts-btn" id="facts-prev" aria-label="Previous fact">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <div class="facts-dots" id="facts-dots">
            {facts.map((_, i) => (
              <span class={`facts-dot${i === 0 ? " active" : ""}`} data-index={i}></span>
            ))}
          </div>
          <button class="facts-btn" id="facts-next" aria-label="Next fact">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- How it works -->
  <section class="section">
    <div class="container">
      <div class="content-narrow">
        <h2 class="fade-in" style="text-align: center; margin-bottom: var(--space-8);">
          How it <em>works</em>
        </h2>
      </div>
      <div class="step-cards fade-in">
        <div class="step-card">
          <h4>Choose your location</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Pick a city from our directory, let your browser locate you, or enter coordinates manually. Your data never leaves the browser.</p>
        </div>
        <div class="step-card">
          <h4>Compute solar events</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">SunCycle calculates your exact sunrise, sunset, solar noon, twilight, golden hour, and blue hour from real solar geometry (NOAA/Spencer algorithm).</p>
        </div>
        <div class="step-card">
          <h4>Get your prescription</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Receive a four-window light schedule personalized to your chronotype: morning bright light, daylight maintenance, evening dim-down, and blue-light cutoff.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Planner -->
  <section class="section" id="planner">
    <div class="container">
      <div class="content-narrow">
        <h2 class="fade-in" style="text-align: center; margin-bottom: var(--space-2);">Your <em>personal</em> light planner</h2>
        <p class="fade-in" style="text-align: center; color: var(--ink-3); margin-bottom: var(--space-10);">Adjust location, date, and chronotype to see your circadian schedule.</p>
      </div>

      <div class="planner-grid">
        <aside class="panel panel-glow fade-in" style="position: sticky; top: 88px;">
          <h3 style="margin-bottom: var(--space-5); font-size: var(--text-xl);">Your location</h3>

          <div style="margin-bottom: var(--space-5);">
            <CustomSelect
              id="city-select"
              options={cityOptions}
              selectedValue={defaultCityValue}
              placeholder="Search cities…"
              searchable={true}
              label="City"
            />
          </div>

          <div style="margin-bottom: var(--space-5);">
            <label class="label" for="date-input">Date</label>
            <input id="date-input" type="date" class="input" value={defaultSolar.date} />
          </div>

          <div style="margin-bottom: var(--space-6);">
            <CustomSelect
              id="chronotype-select"
              options={chronotypeOptions}
              selectedValue="dove"
              placeholder="Select chronotype"
              searchable={false}
              label="Chronotype"
            />
            <p class="note" style="margin-top: var(--space-3);">
              Not sure? Take the <a href="/chronotype">chronotype quiz</a>.
            </p>
          </div>

          <button id="locate-btn" class="btn btn-secondary" style="width: 100%; margin-bottom: var(--space-4);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7;">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
            </svg>
            Use my location
          </button>

          <div id="geo-status" class="note" style="display: none;"></div>

          <hr class="section-divider" style="margin-block: var(--space-6);" />

          <!-- Seasonal daylight preview -->
          <div style="margin-bottom: var(--space-6);">
            <h4 style="font-size: var(--text-sm); color: var(--ink-3); margin-bottom: var(--space-3); text-transform: uppercase; letter-spacing: 0.04em;">
              Seasonal daylight
            </h4>
            <div id="seasonal-chart" class="seasonal-chart">
              <div class="seasonal-bar" id="bar-winter" style="flex: 1;"><span>Dec</span></div>
              <div class="seasonal-bar" id="bar-equinox" style="flex: 2;"><span>Mar</span></div>
              <div class="seasonal-bar" id="bar-summer" style="flex: 3;"><span>Jun</span></div>
              <div class="seasonal-bar" id="bar-autumn" style="flex: 2;"><span>Sep</span></div>
            </div>
            <p class="note" style="margin-top: var(--space-2); text-align: center;" id="seasonal-note">Daylight varies by season at your latitude</p>
          </div>

          <!-- Melatonin rhythm preview -->
          <div style="margin-bottom: var(--space-6);">
            <h4 style="font-size: var(--text-sm); color: var(--ink-3); margin-bottom: var(--space-3); text-transform: uppercase; letter-spacing: 0.04em;">
              Melatonin rhythm
            </h4>
            <div class="melatonin-chart" id="melatonin-chart" aria-label="Melatonin rhythm over 24 hours">
              <svg viewBox="0 0 200 60" preserveAspectRatio="none" class="melatonin-svg">
                <defs>
                  <linearGradient id="melGrad" x1="0" y1="1" x2="1" y2="1">
                    <stop offset="0%" stop-color="var(--bg-3)"/>
                    <stop offset="25%" stop-color="var(--accent-sky)" stop-opacity="0.3"/>
                    <stop offset="50%" stop-color="var(--accent-sky)" stop-opacity="0.15"/>
                    <stop offset="68%" stop-color="var(--bg-3)"/>
                    <stop offset="78%" stop-color="var(--accent-lavender)" stop-opacity="0.25"/>
                    <stop offset="100%" stop-color="var(--accent-lavender)" stop-opacity="0.6"/>
                  </linearGradient>
                </defs>
                <path id="mel-path" d="M0,55 Q25,55 45,48 Q60,40 75,38 Q90,36 100,40 Q115,48 130,52 Q145,55 155,50 Q170,42 185,30 Q200,20 200,20 L200,60 L0,60 Z" fill="url(#melGrad)"/>
              </svg>
              <div class="melatonin-labels">
                <span>06:00</span>
                <span>12:00</span>
                <span>18:00</span>
                <span>00:00</span>
              </div>
            </div>
          </div>

          <div id="share-wrap" class="share" style="display: none;">
            <span class="label" style="margin: 0;">Share plan</span>
            <code id="share-url"></code>
          </div>
        </aside>

        <div class="fade-in fade-in-delay-1">
          <div id="results">
            <div class="panel" style="margin-bottom: var(--space-6);">
              <h3 style="margin-bottom: var(--space-4); font-size: var(--text-xl);">Solar timeline</h3>
              <div class="timeline-wrap">
                <div class="timeline-sun" id="timeline-sun" style="--sun-pct: 50%;"></div>
                <div class="timeline-track">
                  <div class="timeline-bar morning" id="bar-morning"></div>
                  <div class="timeline-bar midday" id="bar-midday"></div>
                  <div class="timeline-bar evening" id="bar-evening"></div>
                  <div class="timeline-bar blue-off" id="bar-blue"></div>
                </div>
                <div class="timeline-axis">
                  <span>00:00</span>
                  <span>06:00</span>
                  <span>12:00</span>
                  <span>18:00</span>
                  <span>24:00</span>
                </div>
              </div>
              <div class="legend">
                <span><i style="background: var(--accent-gold);"></i> Bright light</span>
                <span><i style="background: var(--good);"></i> Daylight</span>
                <span><i style="background: var(--accent-sky);"></i> Dim down</span>
                <span><i style="background: var(--bad);"></i> Blue cutoff</span>
              </div>
            </div>

            <div class="panel" style="margin-bottom: var(--space-6);">
              <h3 style="margin-bottom: var(--space-4); font-size: var(--text-xl);">Today's light windows</h3>
              <div id="windows-list"></div>
            </div>

            <div class="panel">
              <h3 style="margin-bottom: var(--space-4); font-size: var(--text-xl);">Light quality</h3>
              <div class="skybar" id="skybar">
                <div class="marker" id="marker-sunrise" style="left: 25%;"></div>
                <div class="marker" id="marker-sunset" style="left: 75%;"></div>
                <div class="now" id="marker-now" style="left: 50%;"></div>
              </div>
              <div class="legend">
                <span>Night</span>
                <span>Dawn</span>
                <span>Day</span>
                <span>Golden</span>
                <span>Dusk</span>
                <span>Night</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Features -->
  <section class="section">
    <div class="container">
      <div class="content-narrow">
        <h2 class="fade-in" style="text-align: center; margin-bottom: var(--space-2);">
          Built on <em>physics</em>, not guesswork
        </h2>
        <p class="fade-in" style="text-align: center; color: var(--ink-3); margin-bottom: var(--space-10);">
          Every recommendation is anchored to peer-reviewed photobiology and real solar geometry.
        </p>
      </div>
      <div class="feature-grid fade-in">
        <div class="panel">
          <h4>🌅 Solar noon precision</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Sunrise, sunset, twilight, golden hour, and blue hour computed from your exact latitude and longitude using the NOAA solar position model — accurate to ±1 minute.</p>
        </div>
        <div class="panel">
          <h4>🔬 Photobiology-backed</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Light prescriptions follow CIE S 026:2018 melanopic-EDI standards and research by Brainard (ipRGC sensitivity), Figueiro (morning light), and Zeitzer (evening avoidance).</p>
        </div>
        <div class="panel">
          <h4>🦉 Chronotype-aware</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Morning lark, dove, or night owl? Your chronotype shifts every window so the schedule matches your biology, not an arbitrary 9-to-5 clock.</p>
        </div>
        <div class="panel">
          <h4>🔒 Zero data collection</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">No accounts, no cookies, no analytics, no third-party APIs. Your location stays in your browser. Share plans via URL if you choose — entirely opt-in.</p>
        </div>
        <div class="panel">
          <h4>⚡ Instant deep links</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Every plan generates a shareable URL with your coordinates, date, and chronotype. Send it to a friend or bookmark it for later reference.</p>
        </div>
        <div class="panel">
          <h4>🌍 37 cities & counting</h4>
          <p style="color: var(--ink-2); font-size: var(--text-sm);">Pre-loaded directory spanning six continents with valid IANA timezones. Use browser geolocation for anywhere not listed.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2 class="fade-in">Ready to sync with the <em>sun</em>?</h2>
      <p class="fade-in" style="color: var(--ink-2); margin-top: var(--space-4);">Start planning your ideal light day. Free. Forever.</p>
      <div class="fade-in" style="margin-top: var(--space-8);">
        <a href="#planner" class="btn btn-primary" style="font-size: var(--text-lg);">Build my light plan →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { computeSolarDay, formatTime, minutesFromMidnight, formatDate } from "../lib/sun.ts";
  import { derivePrescription, CHRONOTYPE_LABELS } from "../lib/light.ts";
  import { readStateFromUrl, writeStateToUrl } from "../lib/url-state.ts";
  import { CITY_DIRECTORY, nearestCity, guessTimezoneFromLongitude } from "../lib/geo.ts";

  const FACTS = [
    "Morning light advances your circadian clock — exposure within 1h of waking shifts it earlier by up to 30 min/day.",
    "ipRGCs (intrinsically photosensitive retinal ganglion cells) are 10,000× less sensitive to red light than blue.",
    "Two hours of outdoor light daily is linked to a 40% reduction in sleep onset latency.",
    "Melatonin suppression begins at just 30 lux of 480nm light — about the brightness of a smartphone at night.",
    "Your circadian rhythm naturally runs ~24.2 hours. Morning light corrects this drift every day.",
    "The suprachiasmatic nucleus contains only ~20,000 neurons but orchestrates clocks in nearly every organ.",
    "Shift workers have a 25-40% higher risk of metabolic disorders due to circadian misalignment.",
    "Golden hour light (~2,700K color temperature) has low melanopic content — ideal for evening exposure.",
    "Blue hour after sunset provides enough melanopic stimulus to delay sleep onset by 40+ minutes.",
    "Children have larger pupils and more transparent lenses — they receive 2-3× more circadian-effective light than adults.",
    "The CIE S 026:2018 standard defines five α-opic illuminances; melanopic-EDI is the key metric for circadian effects.",
    "Spending 30 minutes outdoors in morning light can reduce depression scores by up to 40% in clinical studies.",
  ];

  // Did You Know carousel
  function initFacts() {
    const textEl = document.getElementById("facts-text");
    const counter = document.getElementById("facts-counter");
    const dots = document.getElementById("facts-dots");
    const prev = document.getElementById("facts-prev");
    const next = document.getElementById("facts-next");
    if (!textEl || !counter || !dots) return;

    let idx = 0;
    function update() {
      textEl.textContent = FACTS[idx];
      counter.textContent = `${idx + 1}/${FACTS.length}`;
      dots.querySelectorAll(".facts-dot").forEach((d, i) => {
        d.classList.toggle("active", i === idx);
      });
    }
    prev?.addEventListener("click", () => { idx = (idx - 1 + FACTS.length) % FACTS.length; update(); });
    next?.addEventListener("click", () => { idx = (idx + 1) % FACTS.length; update(); });
    dots.querySelectorAll(".facts-dot").forEach((d) => {
      d.addEventListener("click", () => { idx = Number((d as HTMLElement).dataset.index); update(); });
    });
    let autoAdvance = setInterval(() => { idx = (idx + 1) % FACTS.length; update(); }, 6000);
    [prev, next, ...dots.querySelectorAll(".facts-dot")].forEach((el) => {
      el?.addEventListener("click", () => { clearInterval(autoAdvance); autoAdvance = setInterval(() => { idx = (idx + 1) % FACTS.length; update(); }, 6000); });
    });
  }

  // Planner logic
  function initPlanner() {
    const citySelectHidden = document.getElementById("city-select");
    const chronotypeSelectHidden = document.getElementById("chronotype-select");
    const dateInput = document.getElementById("date-input") as HTMLInputElement;
    const locateBtn = document.getElementById("locate-btn");
    const geoStatus = document.getElementById("geo-status");
    const shareWrap = document.getElementById("share-wrap");
    const shareUrl = document.getElementById("share-url");

    const barMorning = document.getElementById("bar-morning");
    const barMidday = document.getElementById("bar-midday");
    const barEvening = document.getElementById("bar-evening");
    const barBlue = document.getElementById("bar-blue");
    const timelineSun = document.getElementById("timeline-sun");
    const windowsList = document.getElementById("windows-list");
    const markerSunrise = document.getElementById("marker-sunrise");
    const markerSunset = document.getElementById("marker-sunset");
    const markerNow = document.getElementById("marker-now");

    const seasonalBarWinter = document.getElementById("bar-winter");
    const seasonalBarEquinox = document.getElementById("bar-equinox");
    const seasonalBarSummer = document.getElementById("bar-summer");
    const seasonalBarAutumn = document.getElementById("bar-autumn");
    const seasonalNote = document.getElementById("seasonal-note");

    const melPath = document.getElementById("mel-path");

    const state = {
      lat: parseFloat(citySelectHidden?.value?.split(",")[0] ?? "0"),
      lon: parseFloat(citySelectHidden?.value?.split(",")[1] ?? "0"),
      tz: citySelectHidden?.value?.split(",")[2] ?? "America/New_York",
      date: new Date(),
      chronotype: "dove" as string,
    };

    if (citySelectHidden?.value) {
      const parts = citySelectHidden.value.split(",");
      if (parts.length >= 3) {
        state.lat = parseFloat(parts[0]);
        state.lon = parseFloat(parts[1]);
        state.tz = parts[2];
      }
    }

    function parseCity(v: string) {
      const p = v.split(",");
      return { lat: parseFloat(p[0]), lon: parseFloat(p[1]), tz: p[2] };
    }

    function inputToDate(v: string) { const [y,m,d] = v.split("-").map(Number); return new Date(y,m-1,d); }
    function dateToInput(d: Date) { const y = d.getFullYear(); const m = String(d.getMonth()+1).padStart(2,"0"); const day = String(d.getDate()).padStart(2,"0"); return `${y}-${m}-${day}`; }

    function pct(minutes: number) { return Math.max(0, Math.min(100, (minutes / 1440) * 100)); }

    function updateTimeline(solar, prescription) {
      const sunriseMin = solar.sunrise ? minutesFromMidnight(solar.sunrise) : 360;
      const sunsetMin = solar.sunset ? minutesFromMidnight(solar.sunset) : 1080;
      const noonMin = solar.solarNoon ? minutesFromMidnight(solar.solarNoon) : 720;

      timelineSun.style.setProperty("--sun-pct", `${pct(noonMin)}%`);

      const mStart = prescription[0].start ? minutesFromMidnight(prescription[0].start) : sunriseMin;
      const mEnd = prescription[0].end ? minutesFromMidnight(prescription[0].end) : mStart + 30;
      barMorning.style.left = `${pct(mStart)}%`;
      barMorning.style.width = `${pct(mEnd) - pct(mStart)}%`;

      const mdStart = prescription[1].start ? minutesFromMidnight(prescription[1].start) : noonMin - 60;
      const mdEnd = prescription[1].end ? minutesFromMidnight(prescription[1].end) : noonMin + 60;
      barMidday.style.left = `${pct(mdStart)}%`;
      barMidday.style.width = `${pct(mdEnd) - pct(mdStart)}%`;

      const eStart = prescription[2].start ? minutesFromMidnight(prescription[2].start) : sunsetMin + 120;
      const eEnd = prescription[2].end ? minutesFromMidnight(prescription[2].end) : eStart + 120;
      barEvening.style.left = `${pct(eStart)}%`;
      barEvening.style.width = `${pct(eEnd) - pct(eStart)}%`;

      const bStart = prescription[3].start ? minutesFromMidnight(prescription[3].start) : sunsetMin + 150;
      barBlue.style.left = `${pct(bStart)}%`;
      barBlue.style.width = `${100 - pct(bStart)}%`;

      markerSunrise.style.left = `${pct(sunriseMin)}%`;
      markerSunset.style.left = `${pct(sunsetMin)}%`;
      const nowMin = minutesFromMidnight(new Date());
      markerNow.style.left = `${pct(nowMin)}%`;
    }

    function renderWindows(prescription) {
      windowsList.innerHTML = prescription.map((w, i) => `
        <div class="window-card" style="animation: fadeInUp 0.5s ease ${i * 0.08}s both;">
          <div>
            <h4>${w.label}</h4>
            <p>${w.rationale}</p>
            <div class="source">Source: ${w.source} · Target: ${w.targetLux[0]}–${w.targetLux[1]} lux</div>
          </div>
          <div class="time">
            ${w.start ? formatTime(w.start, state.tz) : "–"}
            ${w.end ? ` → ${formatTime(w.end, state.tz)}` : ""}
          </div>
        </div>
      `).join("");
    }

    function updateSeasonal() {
      const lat = state.lat;
      const absLat = Math.abs(lat);

      // Approximate daylight hours for solstices/equinoxes at this latitude
      function estDaylight(declination: number): number {
        const latRad = lat * Math.PI / 180;
        const decRad = declination * Math.PI / 180;
        const cosTerm = -Math.tan(latRad) * Math.tan(decRad);
        const ha = Math.acos(Math.max(-1, Math.min(1, cosTerm)));
        return (2 * ha * 180 / Math.PI) / 15; // hours
      }

      const winterDL = estDaylight(-23.44);  // Dec solstice
      const equinoxDL = estDaylight(0);       // Mar/Sep equinox
      const summerDL = estDaylight(23.44);    // Jun solstice

      const maxDL = Math.max(winterDL, equinoxDL, summerDL, 12);
      const scale = 100 / maxDL;

      seasonalBarWinter.style.flex = String(Math.max(0.5, winterDL * scale / 25));
      seasonalBarEquinox.style.flex = String(Math.max(0.5, equinoxDL * scale / 25));
      seasonalBarSummer.style.flex = String(Math.max(0.5, summerDL * scale / 25));
      seasonalBarAutumn.style.flex = String(Math.max(0.5, equinoxDL * scale / 25));

      const labels = lat >= 0 ? ["Dec", "Mar", "Jun", "Sep"] : ["Jun", "Sep", "Dec", "Mar"];
      [seasonalBarWinter, seasonalBarEquinox, seasonalBarSummer, seasonalBarAutumn].forEach((bar, i) => {
        const span = bar?.querySelector("span");
        if (span) span.textContent = labels[i];
      });

      const diff = Math.abs(summerDL - winterDL);
      if (diff < 1.5) {
        seasonalNote.textContent = `Near the equator — daylight stays ~${equinoxDL.toFixed(1)}h year-round`;
      } else if (diff > 8) {
        seasonalNote.textContent = `High latitude — daylight ranges from ${winterDL.toFixed(1)}h to ${summerDL.toFixed(1)}h`;
      } else {
        seasonalNote.textContent = `Daylight varies from ${winterDL.toFixed(0)}h (winter) to ${summerDL.toFixed(0)}h (summer)`;
      }
    }

    function updateMelatonin(solar) {
      if (!melPath) return;
      const sunsetMin = solar.sunset ? minutesFromMidnight(solar.sunset) : 1080;
      const onsetPct = sunsetMin / 1440;
      const risePct = Math.max(0, (sunsetMin + 120) / 1440);
      const peakPct = Math.min(1, (sunsetMin + 360) / 1440);
      const fallPct = solar.sunrise ? minutesFromMidnight(solar.sunrise) / 1440 : 0.25;

      // Build SVG path — low during day, rises after sunset, peaks mid-sleep, drops at sunrise
      const x0 = fallPct * 200;
      const x1 = onsetPct * 200;
      const x2 = risePct * 200;
      const x3 = peakPct * 200;

      // Handle wrap-around (if peak is past midnight)
      const d = peakPct < onsetPct
        ? `M0,55 Q${x3/2},55 ${x3},30 Q${x3*1.2},20 ${x0},40 Q${(x0+x1)/2},55 ${x1},52 Q${(x1+x2)/2},45 ${x2},38 Q${(x2+200)/2},35 200,30 L200,60 L0,60 Z`
        : `M0,55 Q${x0*0.5},50 ${x0},38 Q${(x0+x1)/2},55 ${x1},52 Q${(x1+x2)/2},45 ${x2},35 Q${(x2+x3)/2},28 ${x3},30 Q${(x3+200)/2},35 200,30 L200,60 L0,60 Z`;

      melPath.setAttribute("d", d);
    }

    function refresh() {
      const solar = computeSolarDay(state.date, state.lat, state.lon, state.tz);
      const prescription = derivePrescription(solar, state.chronotype as any);
      updateTimeline(solar, prescription);
      renderWindows(prescription);
      updateSeasonal();
      updateMelatonin(solar);

      const url = writeStateToUrl({ lat: state.lat, lon: state.lon, tz: state.tz }, `${location.origin}${location.pathname}`);
      const full = `${url}&date=${dateToInput(state.date)}&chronotype=${state.chronotype}`;
      shareUrl.textContent = full;
      shareWrap.style.display = "flex";
    }

    // Listen for changes on hidden inputs (set by CustomSelect)
    citySelectHidden?.addEventListener("change", () => {
      const c = parseCity(citySelectHidden.value);
      state.lat = c.lat;
      state.lon = c.lon;
      state.tz = c.tz;
      refresh();
    });

    dateInput?.addEventListener("change", (e) => {
      state.date = inputToDate((e.target as HTMLInputElement).value);
      refresh();
    });

    chronotypeSelectHidden?.addEventListener("change", () => {
      state.chronotype = chronotypeSelectHidden.value;
      refresh();
    });

    locateBtn?.addEventListener("click", () => {
      geoStatus.style.display = "block";
      geoStatus.textContent = "Requesting location…";
      if (!navigator.geolocation) {
        geoStatus.textContent = "Geolocation not supported by this browser.";
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          state.lat = pos.coords.latitude;
          state.lon = pos.coords.longitude;
          state.tz = Intl.DateTimeFormat().resolvedOptions().timeZone || guessTimezoneFromLongitude(state.lon);
          const city = nearestCity(state.lat, state.lon);
          geoStatus.textContent = `Located near ${city.city}, ${city.country}.`;
          refresh();
        },
        (err) => {
          geoStatus.textContent = "Location denied. Using selected city.";
        }
      );
    });

    // Initialize from URL if present
    const urlState = readStateFromUrl(location.search);
    if (urlState) {
      state.lat = urlState.lat;
      state.lon = urlState.lon;
      state.tz = urlState.tz;
      const params = new URLSearchParams(location.search);
      const d = params.get("date");
      const ct = params.get("chronotype");
      if (d) state.date = inputToDate(d);
      if (ct && ["lark", "dove", "owl"].includes(ct)) state.chronotype = ct;
    }

    const matchedCity = CITY_DIRECTORY.find((c) => c.lat === state.lat && c.lon === state.lon && c.timezone === state.tz);
    if (!matchedCity) {
      const city = nearestCity(state.lat, state.lon);
      if (citySelectHidden) citySelectHidden.value = `${city.lat},${city.lon},${city.timezone}`;
    } else {
      if (citySelectHidden) citySelectHidden.value = `${state.lat},${state.lon},${state.tz}`;
    }
    if (dateInput) dateInput.value = dateToInput(state.date);
    if (chronotypeSelectHidden) chronotypeSelectHidden.value = state.chronotype;

    refresh();
  }
  function boot() {
    initFacts();
    initPlanner();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

</script>

