---
export interface SelectOption {
  value: string;
  label: string;
  sub?: string;
  group?: string;
}

export interface Props {
  id: string;
  options: SelectOption[];
  selectedValue?: string;
  placeholder?: string;
  searchable?: boolean;
  label?: string;
}
const {
  id,
  options,
  selectedValue = "",
  placeholder = "Select an option…",
  searchable = true,
  label = "",
} = Astro.props;

const selected = options.find((o) => o.value === selectedValue);
const displayText = selected ? selected.label : placeholder;

const groups = new Map<string, SelectOption[]>();
for (const o of options) {
  const g = o.group ?? "";
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g)!.push(o);
}
---

<div class="cs-root" id={`cs-${id}`} data-id={id}>
  {label && <label class="label" for={`cs-btn-${id}`}>{label}</label>}
  <button
    type="button"
    class="cs-trigger"
    id={`cs-btn-${id}`}
    aria-haspopup="listbox"
    aria-expanded="false"
    role="combobox"
    aria-controls={`cs-list-${id}`}
    data-value={selectedValue}
  >
    <span class="cs-trigger-text">{displayText}</span>
    <span class="cs-chevron" aria-hidden="true">
      <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </button>

  <div class="cs-dropdown" id={`cs-list-${id}`} role="listbox" aria-labelledby={`cs-btn-${id}`} hidden>
    {searchable && groups.size > 1 && (
      <div class="cs-search-wrap">
        <svg class="cs-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input
          type="text"
          class="cs-search"
          id={`cs-search-${id}`}
          placeholder="Search…"
          autocomplete="off"
        />
      </div>
    )}

    <div class="cs-options" id={`cs-options-${id}`}>
      {groups.size > 1
        ? Array.from(groups.entries()).map(([group, items]) => (
            <div class="cs-group">
              {group && <div class="cs-group-label">{group}</div>}
              {items.map((o) => (
                <div
                  class={`cs-option${o.value === selectedValue ? " cs-selected" : ""}`}
                  role="option"
                  aria-selected={o.value === selectedValue ? "true" : "false"}
                  data-value={o.value}
                  data-search={`${o.label} ${o.sub ?? ""} ${o.group ?? ""}`.toLowerCase()}
                >
                  <span class="cs-option-label">{o.label}</span>
                  {o.sub && <span class="cs-option-sub">{o.sub}</span>}
                </div>
              ))}
            </div>
          ))
        : options.map((o) => (
            <div
              class={`cs-option${o.value === selectedValue ? " cs-selected" : ""}`}
              role="option"
              aria-selected={o.value === selectedValue ? "true" : "false"}
              data-value={o.value}
              data-search={`${o.label} ${o.sub ?? ""}`.toLowerCase()}
            >
              <span class="cs-option-label">{o.label}</span>
              {o.sub && <span class="cs-option-sub">{o.sub}</span>}
            </div>
          ))}
    </div>
  </div>

  <input type="hidden" id={id} name={id} value={selectedValue} />
</div>

<script>
  function initAllCustomSelects() {
    document.querySelectorAll(".cs-root").forEach(initCustomSelect);
  }

  function initCustomSelect(root) {
    if ((root as HTMLElement).dataset.csInit === "true") return;
    (root as HTMLElement).dataset.csInit = "true";

    const trigger = root.querySelector(".cs-trigger") as HTMLElement;
    if (!trigger) return;
    const dropdown = root.querySelector(".cs-dropdown") as HTMLElement;
    const hidden = root.querySelector("input[type=hidden]") as HTMLInputElement;
    const triggerText = trigger.querySelector(".cs-trigger-text") as HTMLElement;
    const searchInput = root.querySelector(".cs-search") as HTMLInputElement;
    const allOptions = root.querySelectorAll(".cs-option") as NodeListOf<HTMLElement>;

    let open = false;
    let activeIndex = -1;

    function openDropdown() {
      open = true;
      if (dropdown) dropdown.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      root.classList.add("cs-open");
      const selIdx = findSelectedIndex();
      activeIndex = selIdx != null ? selIdx : 0;
      highlightOption(activeIndex);
      if (searchInput) setTimeout(() => searchInput.focus(), 80);
    }

    function closeDropdown() {
      open = false;
      if (dropdown) dropdown.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      root.classList.remove("cs-open");
      activeIndex = -1;
      if (searchInput) { searchInput.value = ""; }
      filterOptions("");
    }

    function findSelectedIndex(): number | null {
      const sel = root.querySelector(".cs-selected");
      if (!sel) return null;
      const visible = getVisibleOptions();
      return visible.indexOf(sel as HTMLElement);
    }

    function getVisibleOptions(): HTMLElement[] {
      return Array.from(allOptions).filter((o) => !o.hidden);
    }

    function highlightOption(index: number) {
      allOptions.forEach((o) => o.classList.remove("cs-focused"));
      const visible = getVisibleOptions();
      if (index >= 0 && index < visible.length) {
        visible[index].classList.add("cs-focused");
        visible[index].scrollIntoView({ block: "nearest" });
      }
    }

    function selectOption(opt: HTMLElement) {
      const val = opt.dataset.value;
      if (!val) return;
      const labelEl = opt.querySelector(".cs-option-label") as HTMLElement;
      if (triggerText) triggerText.textContent = labelEl?.textContent ?? val;
      trigger.dataset.value = val;
      if (hidden) {
        hidden.value = val;
        // Dispatch on the hidden input so parent forms/scripts can listen
        hidden.dispatchEvent(new Event("change", { bubbles: true }));
        hidden.dispatchEvent(new Event("input", { bubbles: true }));
      }
      allOptions.forEach((o) => {
        o.setAttribute("aria-selected", o.dataset.value === val ? "true" : "false");
        o.classList.toggle("cs-selected", o.dataset.value === val);
      });
      closeDropdown();
    }

    function filterOptions(term: string) {
      const t = term.toLowerCase().trim();
      allOptions.forEach((o) => {
        const searchText = (o.dataset.search ?? "").toLowerCase();
        o.hidden = t.length > 0 && !searchText.includes(t);
      });
      root.querySelectorAll(".cs-group").forEach((g) => {
        const visible = g.querySelectorAll(".cs-option:not([hidden])").length;
        const label = g.querySelector(".cs-group-label") as HTMLElement;
        (g as HTMLElement).hidden = visible === 0;
        if (label) label.hidden = visible === 0;
      });
    }

    trigger.addEventListener("click", () => {
      open ? closeDropdown() : openDropdown();
    });

    trigger.addEventListener("keydown", (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "ArrowDown" || ke.key === "Enter" || ke.key === " ") {
        e.preventDefault();
        if (!open) openDropdown();
        else if (ke.key === "ArrowDown") {
          activeIndex = Math.min(activeIndex + 1, getVisibleOptions().length - 1);
          highlightOption(activeIndex);
        }
      }
    });

    root.addEventListener("keydown", (e) => {
      if (!open) return;
      const ke = e as KeyboardEvent;
      const visible = getVisibleOptions();
      if (ke.key === "Escape") { e.preventDefault(); closeDropdown(); trigger.focus(); }
      else if (ke.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, visible.length - 1);
        highlightOption(activeIndex);
      }
      else if (ke.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        highlightOption(activeIndex);
      }
      else if (ke.key === "Enter") {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < visible.length) {
          selectOption(visible[activeIndex]);
        }
      }
      else if (ke.key === "Tab") { closeDropdown(); }
    });

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        filterOptions(searchInput.value);
        activeIndex = 0;
        const visible = getVisibleOptions();
        if (visible.length > 0) highlightOption(0);
      });
    }

    allOptions.forEach((opt) => {
      opt.addEventListener("click", () => selectOption(opt));
      opt.addEventListener("mousemove", () => {
        const visible = getVisibleOptions();
        activeIndex = visible.indexOf(opt);
        highlightOption(activeIndex);
      });
    });

    document.addEventListener("click", (e) => {
      if (open && !root.contains(e.target as Node)) closeDropdown();
    });
  }

  // Run on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllCustomSelects);
  } else {
    initAllCustomSelects();
  }
</script>

<style>
  .cs-root {
    position: relative;
    width: 100%;
  }
  .cs-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    padding: 0.65rem 0.9rem;
    background: var(--bg-3);
    border: 1px solid var(--bg-4);
    border-radius: var(--radius-md);
    color: var(--ink-1);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    text-align: left;
    font-family: var(--font-body);
    line-height: 1.4;
  }
  .cs-trigger:hover {
    border-color: var(--line-strong);
    background: var(--bg-4);
  }
  .cs-trigger:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
    border-color: var(--accent-gold-dim);
    box-shadow: 0 0 0 3px rgba(244,184,96,0.12);
  }
  .cs-open .cs-trigger {
    border-color: var(--accent-gold-dim);
    box-shadow: 0 0 0 3px rgba(244,184,96,0.1), var(--shadow-glow-sm);
    background: var(--bg-4);
  }
  .cs-trigger-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cs-chevron {
    display: flex;
    align-items: center;
    color: var(--ink-3);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }
  .cs-open .cs-chevron {
    transform: rotate(180deg);
    color: var(--accent-gold);
  }
  .cs-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-2);
    border: 1px solid var(--bg-4);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(255,255,255,0.04);
    overflow: hidden;
    animation: csFadeIn 0.15s ease;
    max-height: 320px;
    display: flex;
    flex-direction: column;
  }
  @keyframes csFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .cs-search-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    background: var(--bg-3);
  }
  .cs-search-icon { color: var(--ink-3); flex-shrink: 0; }
  .cs-search {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--ink-1);
    font-size: var(--text-sm);
    padding: 0.35rem 0;
    outline: none;
    font-family: var(--font-body);
  }
  .cs-search::placeholder { color: var(--ink-4); }
  .cs-options { overflow-y: auto; padding: var(--space-2); scroll-behavior: smooth; }
  .cs-options::-webkit-scrollbar { width: 4px; }
  .cs-options::-webkit-scrollbar-track { background: transparent; }
  .cs-options::-webkit-scrollbar-thumb { background: var(--bg-4); border-radius: 4px; }
  .cs-group-label {
    font-size: var(--text-xs); font-weight: 600; color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-3); margin-top: var(--space-1);
  }
  .cs-group:first-child .cs-group-label { margin-top: 0; }
  .cs-option {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: 0.55rem 0.75rem; border-radius: var(--radius-sm); cursor: pointer;
    transition: background 0.12s ease; font-size: var(--text-sm); color: var(--ink-2);
  }
  .cs-option:hover, .cs-option.cs-focused {
    background: rgba(244,184,96,0.08); color: var(--ink-0);
  }
  .cs-option.cs-selected {
    background: rgba(244,184,96,0.12); color: var(--accent-gold); font-weight: 500;
  }
  .cs-option-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cs-option-sub { font-size: var(--text-xs); color: var(--ink-3); flex-shrink: 0; }
  .cs-option.cs-selected .cs-option-sub { color: var(--accent-gold-dim); }
</style>
